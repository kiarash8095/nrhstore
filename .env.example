# Independent banner administrator. No NEXT_PUBLIC_ prefix on any of these.
BANNERS_ADMIN_USERNAME=admin
# Choose a unique password of at least 12 characters.
BANNERS_ADMIN_PASSWORD=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BANNERS_ADMIN_SESSION_SECRET=
# Optional absolute persistent storage directory. Default: ./data/banners
BANNERS_DATA_DIR=

# Store customers are authenticated by WordPress (separate from banner admin).
WP_AUTH_BASE_URL=https://nrhstore.ir/wp-json
WP_AUTH_NAMESPACE=boom/v1
WP_AUTH_TIMEOUT_MS=10000
# Server-only random encryption key; at least 32 characters.
