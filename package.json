{
  "name": "nrh_store_nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup:env": "node scripts/environment.cjs --setup",
    "predev": "node scripts/environment.cjs --setup",
    "dev": "next dev",
    "prebuild": "node scripts/environment.cjs --build",
    "build": "next build",
    "prestart": "node scripts/environment.cjs --production",
    "start": "next start",
    "doctor": "node scripts/environment.cjs --network",
    "doctor:production": "node scripts/environment.cjs --production --network",
    "test:environment": "node --test tests/environment/*.test.cjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test:banners": "node features/banners/tests/banners.integration.cjs",
    "test:banners:browser": "node features/banners/tests/banners.browser.cjs",
    "test:banners:public:browser": "node features/banners/tests/banners.public.browser.cjs",
    "test:auth": "node --test features/auth/tests/auth.security.cjs",
    "test:auth:live": "node features/auth/tests/auth-cart.live.cjs",
    "test:auth:browser": "node features/auth/tests/auth.browser.cjs",
    "test:providers:browser": "node features/auth/tests/providers.browser.cjs",
    "typecheck:auth": "tsc --noEmit -p features/auth/tests/tsconfig.auth.json",
    "test:headless": "node --test features/products/tests/*.test.cjs",
    "test:cart": "node --test features/cart/tests/cart.integration.cjs",
    "test:cart:live": "node features/cart/tests/cart.live.cjs",
    "test:cart:browser": "node features/cart/tests/cart.browser.cjs",
    "test:race:server": "node tests/race-conditions/server.audit.cjs",
    "test:race:browser": "node tests/race-conditions/browser.audit.cjs",
    "test:race:live": "node tests/race-conditions/cart.live.audit.cjs",
    "test:race:locks": "node --test tests/race-conditions/cart-lock.test.cjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.27.0",
    "motion": "^13.1.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.88.0",
    "react-icons": "^5.7.0",
    "react-loader-spinner": "^8.0.2",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
